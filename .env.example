# All settings are optional. No API keys are used anywhere in this plugin.
# Set these in your shell or in the "env" block of Claude Code settings.

# Folder (relative to the session working directory) that holds scope files.
OPS_KIT_SCOPE_DIR=.context

# 1 = also block when the session has no scope file or the file has no items.
OPS_KIT_REQUIRE_SCOPE=0

# 1 = ticked items must carry an "evidence:" note or they count as unresolved.
OPS_KIT_REQUIRE_EVIDENCE=0

# 1 = block at most once per stop sequence (allow when stop_hook_active is true).
OPS_KIT_BLOCK_ONCE=0

# 1 = let the turn end while background tasks are still running (session is paused, not done).
OPS_KIT_ALLOW_WHEN_BACKGROUND=1

# 1 = turn the gate off without uninstalling the plugin.
OPS_KIT_DISABLE=0
